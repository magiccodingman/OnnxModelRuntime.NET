<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OnnxModelRuntime.NET</PackageId>
    <Description>Reusable ONNX Runtime model hosting, bounded queueing, concurrency, load balancing, failure isolation, and recovery for .NET.</Description>
    <PackageTags>onnx;runtime;inference;machine-learning;ai;native-aot</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>128x128_compressed.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../128x128_compressed.png" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="OnnxModelRuntime.Tests" />
  </ItemGroup>
</Project>
